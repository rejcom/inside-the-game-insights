# Microsoft Foundry project (Azure AI Foundry portal > your project > Overview > endpoint)
FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Model deployment name inside the project
FOUNDRY_MODEL=gpt-5.4-mini
# Auth: "default" = DefaultAzureCredential (az login, managed identity); "browser" = one-time browser sign-in
FOUNDRY_AUTH=default
# Needed for FOUNDRY_AUTH=browser
AZURE_TENANT_ID=
# Per-agent timeout before falling back to the deterministic twin
INSIGHTS_AGENT_TIMEOUT_S=20
